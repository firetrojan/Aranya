<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup rules.

  Aranya's cached data (the last retrieved weather reading) is disposable: it can be
  re-fetched. Excluding it keeps backups small and avoids pushing a user's agronomic
  history onto a cloud backup they did not choose.

  Only two things are included, so everything else is excluded implicitly. Explicit
  <exclude> entries are therefore unnecessary and Lint rejects excludes that do not sit
  inside an included path.
-->
<full-backup-content>
    <include domain="sharedpref" path="." />
    <include domain="file" path="datastore" />
</full-backup-content>